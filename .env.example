# Copy to .env.local (never commit .env.local).
#
# Web3Forms access key for the online application form on /apply.
# Get one free at https://web3forms.com — enter the school's admissions
# inbox and the key is emailed to you. The DESTINATION email is tied to
# the key / managed in the Web3Forms dashboard, not in code.
# Without this set, /apply still renders but shows "online submission
# not activated" and points applicants to the downloadable form.
NEXT_PUBLIC_WEB3FORMS_KEY=your_web3forms_access_key_here
